{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/main/**/*.ts",
    "src/preload/*.ts",
    "src/shared/**/*.ts",
    "src/features/*/shared/**/*.ts",
    "src/features/*/main/**/*.ts"
  ],
  "exclude": ["src/shared/ui/**"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@student/*": ["./src/features/student/main/*"],
      "@frequentation/*": ["./src/features/frequentation/main/*"],
      "@statistics/*": ["./src/features/statistics/main/*"],
      "@settings/*": ["./src/features/settings/main/*"],
      "@settings-shared": ["./src/features/settings/shared"],
      "@student-shared": ["./src/features/student/shared"],
      "@frequentation-shared": ["./src/features/frequentation/shared"],
      "@statistics-shared": ["./src/features/statistics/shared"],
      "@shared/*": ["./src/shared/*"],
      "@lib/*": ["./src/shared/lib/*"],
      "@lib": ["./src/shared/lib"],
      "@types": ["./src/shared/types"]
    }
  }
}
