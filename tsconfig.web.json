{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/features/*/shared/**/*.ts",
    "src/features/*/renderer/**/*.ts",
    "src/features/*/renderer/**/*.tsx"
  ],
  "exclude": ["src/shared/db/**/*"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "paths": {
      "@student/*": ["./src/features/student/renderer/*"],
      "@frequentation/*": ["./src/features/frequentation/renderer/*"],
      "@statistics/*": ["./src/features/statistics/renderer/*"],
      "@student-shared": ["./src/features/student/shared"],
      "@frequentation-shared": ["./src/features/frequentation/shared"],
      "@statistics-shared": ["./src/features/statistics/shared"],
      "@shared/*": ["./src/shared/*"],
      "@ui/*": ["./src/shared/ui/*"],
      "@lib/*": ["./src/shared/lib/*"],
      "@lib": ["./src/shared/lib"],
      "@types": ["./src/shared/types"]
    }
  }
}
